APP_NAME=local-voice-ai-assistant
ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
STT_MODEL_SIZE=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en
TTS_PROVIDER=piper
PIPER_MODEL_PATH=models/piper/en_US-lessac-medium.onnx
PIPER_CONFIG_PATH=models/piper/en_US-lessac-medium.onnx.json
TTS_OUTPUT_DIR=storage/tts
VOICE_MAX_TURNS=5
VOICE_GREETING=Hello! I'm your voice assistant. Ask me a question after the beep, and say goodbye when you're finished.
VOICE_THINKING_PROMPT=One moment please, I'm thinking.

# Docker Compose overrides OLLAMA_BASE_URL to http://ollama:11434 automatically.
